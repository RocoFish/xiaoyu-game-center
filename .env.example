# ===== Supabase 配置 =====
# 在 Supabase 控制台 → Project Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== 服务端防作弊签名密钥 =====
# 任意生成一段足够长的随机字符串（例如用 openssl rand -base64 32 生成）
ANTI_CHEAT_SECRET=

# ===== 可选：服务角色密钥 =====
# 仅服务端使用，拥有绕过 RLS 的权限，切勿暴露给前端 / 提交到仓库
# SUPABASE_SERVICE_ROLE_KEY=
